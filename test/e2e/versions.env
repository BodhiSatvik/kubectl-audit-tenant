# Exact versions for the kind end-to-end test. CI reads only this file.
# Pinned 2026-10-11: the newest 1.37 node image (digest from the kind v0.33.0 release notes) and
# the newest Kyverno 1.x chart at that time.
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
KYVERNO_CHART_VERSION=3.9.1
KYVERNO_APP_VERSION=v1.19.1
# Last kyverno/policies commit that still ships the restrict-nodeport ClusterPolicy
# (best-practices/restrict-node-port); the next commit keeps only CEL-based policies.
KYVERNO_POLICIES_COMMIT=d12f1b56ff051b2b5e59ffd7d3d563f8add30547
# PolicyReport CRD (wgpolicyk8s.io/v1alpha2) in kubernetes-sigs/wg-policy-prototypes, used by -o policyreport (B24).
POLICYREPORT_CRD_COMMIT=ed0ca5a1c7788055074c7500915b76fc4518ed33
POLICYREPORT_CRD_PATH=policy-report/crd/wgpolicyk8s.io/v1alpha2/wgpolicyk8s.io_policyreports.yaml
