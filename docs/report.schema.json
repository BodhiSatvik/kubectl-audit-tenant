{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "audit-tenant report (kubectl audit-tenant -o json)",
  "description": "One run of kubectl audit-tenant: one result per check result, in ID order (DESIGN.md section 6). The apiVersion is one-way after release. A minor release may add fields at any level, so a consumer must ignore fields it does not know; a removed or renamed field gets a new apiVersion (D171).",
  "type": "object",
  "required": ["apiVersion", "tool", "cluster", "namespace", "otherNamespace", "identity", "timestamp", "results", "summary"],
  "properties": {
    "apiVersion": {"const": "audit-tenant.dev/v1alpha1"},
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "audit-tenant"},
        "version": {"type": "string"}
      }
    },
    "cluster": {
      "type": "object",
      "required": ["context", "server", "version"],
      "properties": {
        "context": {"type": "string", "description": "kubeconfig context name"},
        "server": {"type": "string"},
        "version": {"type": "string", "description": "the API server's gitVersion"}
      }
    },
    "namespace": {"type": "string", "minLength": 1},
    "otherNamespace": {"type": "string", "minLength": 1, "description": "--other-namespace, the namespace AT-02 asks about"},
    "identity": {
      "type": "object",
      "required": ["mode", "username", "groups", "verified"],
      "properties": {
        "mode": {"enum": ["self", "impersonation"]},
        "username": {"type": "string"},
        "groups": {"type": "array", "items": {"type": "string"}},
        "verified": {"type": "boolean", "description": "true when a SelfSubjectReview named the identity (ADR 0009)"}
      }
    },
    "warnings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "description": "what the identity or flags leave untested, such as --as without --as-group (D141), and the cluster-admin hint of a self run (D173); absent when none"},
    "timestamp": {"type": "string", "format": "date-time"},
    "results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/result"}},
    "summary": {
      "type": "object",
      "required": ["pass", "fail", "skip", "error", "exitCode", "results", "checks"],
      "properties": {
        "pass": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "skip": {"type": "integer", "minimum": 0},
        "error": {"type": "integer", "minimum": 0},
        "exitCode": {"enum": [0, 1, 2], "description": "the process exit code (ADR 0004), after --fail-on-skip"},
        "results": {"type": "integer", "minimum": 1, "description": "counts are per result: AT-04 has five"},
        "checks": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "required": ["id", "name", "kind", "mtb", "severity", "verdict", "layer", "reason", "hint"],
      "properties": {
        "id": {"type": "string", "pattern": "^AT-[0-9]{2}(\\.[0-9])?$"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["behavioral", "config", "computed"]},
        "mtb": {"type": "string", "pattern": "^(-|MTB-PL[0-9]-[A-Z]{2}-[A-Z]{2,3}-[0-9]+)$", "description": "the kubectl-mtb benchmark ID, or - when none"},
        "severity": {"enum": ["high", "medium", "low"]},
        "verdict": {"enum": ["PASS", "FAIL", "SKIP", "ERROR"]},
        "layer": {"type": "string", "minLength": 1, "description": "the deciding layer: RBAC, admission (...), API server (allow-privileged=false), config, or -"},
        "reason": {"type": "string", "minLength": 1, "description": "the full text, never cut; it can quote the server. A control or format character other than newline and tab shows as <U+XXXX> (D170)"},
        "hint": {"type": "string", "description": "empty only on PASS"},
        "note": {"type": "string", "minLength": 1, "description": "what the check did not test (D86); absent when nothing"}
      },
      "if": {"properties": {"verdict": {"const": "PASS"}}},
      "else": {"properties": {"hint": {"minLength": 1}}}
    }
  }
}
